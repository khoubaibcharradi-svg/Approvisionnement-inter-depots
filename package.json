{
  "name": "approvisionnement-inter-depots",
  "version": "0.1.0",
  "private": true,
  "description": "Portail d'approvisionnement commercial et de traçabilité inter-dépôts (Radès)",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/sauvegarde.ts",
    "db:restore": "tsx scripts/restauration.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "jose": "6.2.12",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "16.4.7",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "uuid": "11.1.1",
    "deepmerge-ts": "8.0.0"
  }
}
