// Portail d'approvisionnement inter-dépôts — schéma MySQL 8
//
// Conventions :
// - Clés métier uniquement (aucun identifiant technique auto-incrémenté) : code article,
//   code canal, code dépôt, login, numéro de demande « DA-000001 », etc.
//   Les clés étrangères sont en ON UPDATE CASCADE pour qu'un code métier puisse être renommé.
// - Toutes les tables de référence et de transaction portent les colonnes de cycle de vie :
//   isActif, isDeleted, dateCreation/creePar, dateModification/modifiePar,
//   dateSuppression/supprimePar. Aucune ligne n'est supprimée physiquement (suppression logique).
// - Les tables de traçabilité (journal_audit, historique_demande) sont en ajout seul :
//   elles n'ont volontairement ni isDeleted ni date de modification (journal inaltérable).
// - « version » sert au verrouillage optimiste (plusieurs utilisateurs sur la même demande).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TypeDepot {
  CENTRAL
  REGIONAL
}

enum StatutDemande {
  A_VALIDER
  A_APPROUVER
  APPROUVEE
  EN_PREPARATION
  EXPEDIEE
  REJETEE
}

enum Unite {
  PIECE
  CARTON
}

enum DecisionLigne {
  ACCORD
  REFUS
  MODIFICATION
}

enum StatutModification {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  RETIREE
  ANNULEE
}

enum TypeImport {
  CATALOGUE
  STOCK
  PRIX
}

enum StatutCompteRendu {
  BROUILLON
  SOUMIS
}

/// Section du compte rendu à laquelle une pièce jointe est annexée.
enum RubriquePiece {
  STOCK
  RECETTES
  DEPENSES
}

enum StatutInventaire {
  EN_COURS
  CLOTURE
}

enum NatureCaisse {
  ESPECES
  CHEQUES
  TRAITES
  AUTRES
}

// ───────────────────────────── Référentiels ─────────────────────────────

model Role {
  code             String    @id @db.VarChar(30)
  libelle          String    @db.VarChar(80)
  ordre            Int       @default(0)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  utilisateurs Utilisateur[]

  @@map("role")
}

model Canal {
  code             String    @id @db.VarChar(30)
  libelle          String    @db.VarChar(80)
  ordre            Int       @default(0)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  affectations Affectation[]
  demandes     Demande[]

  @@map("canal")
}

model Depot {
  code             String    @id @db.VarChar(30)
  libelle          String    @db.VarChar(80)
  type             TypeDepot
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  affectations  Affectation[]
  demandes      Demande[]
  agents        Utilisateur[] @relation("AgentDepot")
  magasins      Magasin[]
  comptesRendus CompteRendu[]
  vehicules     Vehicule[]

  @@map("depot")
}

model Famille {
  code             String    @id @db.VarChar(60)
  libelle          String    @db.VarChar(100)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  articles Article[]

  @@map("famille")
}

/// Stock et quota en pièces ; rotation en cartons par mois (RG-08).
model Article {
  codeArticle      String    @id @db.VarChar(30)
  designation      String    @db.VarChar(200)
  codeFamille      String    @db.VarChar(60)
  /// Pièces par carton ; null tant que la logistique ne l'a pas renseigné.
  pcb              Int?
  ean              String?   @db.VarChar(20)
  stockPieces      Int       @default(0)
  quotaPieces      Int       @default(0)
  rotationCartons  Decimal?  @db.Decimal(12, 2)
  /// Coût de revient unitaire (dinars par pièce), base de la valorisation des inventaires.
  prixRevient      Decimal   @default(0) @db.Decimal(14, 3)
  dateMajPrix      DateTime?
  dateMajStock     DateTime?
  sourceStock      String?   @db.VarChar(150)
  version          Int       @default(0)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  famille     Famille           @relation(fields: [codeFamille], references: [code], onUpdate: Cascade, onDelete: Restrict)
  lignes      LigneDemande[]
  inventaires InventaireLigne[]

  @@index([codeFamille])
  @@index([designation])
  @@index([isDeleted, isActif])
  @@map("article")
}

// ───────────────────────────── Utilisateurs ─────────────────────────────

model Utilisateur {
  login                    String    @id @db.VarChar(50)
  nomComplet               String    @db.VarChar(100)
  email                    String?   @db.VarChar(150)
  codeRole                 String    @db.VarChar(30)
  motDePasseHash           String    @db.VarChar(100)
  doitChangerMotDePasse    Boolean   @default(true)
  dateChangementMotDePasse DateTime?
  nbEchecsConnexion        Int       @default(0)
  verrouilleJusqua         DateTime?
  derniereConnexion        DateTime?
  /// Incrémenté à chaque changement de mot de passe ou désactivation : invalide les sessions ouvertes.
  versionSession           Int       @default(0)
  /// Dépôt de rattachement d'un agent dépôt (rôle AGENT_DEPOT).
  codeDepotAgent           String?   @db.VarChar(30)
  isActif                  Boolean   @default(true)
  isDeleted                Boolean   @default(false)
  dateCreation             DateTime  @default(now())
  creePar                  String?   @db.VarChar(50)
  dateModification         DateTime  @updatedAt
  modifiePar               String?   @db.VarChar(50)
  dateSuppression          DateTime?
  supprimePar              String?   @db.VarChar(50)

  role          Role          @relation(fields: [codeRole], references: [code], onUpdate: Cascade, onDelete: Restrict)
  depotAgent    Depot?        @relation("AgentDepot", fields: [codeDepotAgent], references: [code], onUpdate: Cascade, onDelete: Restrict)
  affectations  Affectation[]
  demandes      Demande[]
  comptesRendus CompteRendu[]

  @@index([codeRole])
  @@index([codeDepotAgent])
  @@map("utilisateur")
}

/// Canaux d'un utilisateur (Chef de Vente, Superviseur) et dépôt imposé pour un Superviseur.
model Affectation {
  login            String    @db.VarChar(50)
  codeCanal        String    @db.VarChar(30)
  codeDepot        String?   @db.VarChar(30)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  utilisateur Utilisateur @relation(fields: [login], references: [login], onUpdate: Cascade, onDelete: Restrict)
  canal       Canal       @relation(fields: [codeCanal], references: [code], onUpdate: Cascade, onDelete: Restrict)
  depot       Depot?      @relation(fields: [codeDepot], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([login, codeCanal])
  @@index([codeCanal])
  @@index([codeDepot])
  @@map("affectation")
}

// ───────────────────────────── Demandes ─────────────────────────────

model Demande {
  numero           String        @id @db.VarChar(20)
  codeCanal        String        @db.VarChar(30)
  codeDepot        String        @db.VarChar(30)
  loginSaisie      String        @db.VarChar(50)
  statut           StatutDemande @default(A_VALIDER)
  /// Étape à laquelle la demande a été rejetée : 1 Chef de Vente, 2 Dir. commercial, 3 Radès.
  etapeRejet       Int?
  motif            String?       @db.Text
  dateSaisie       DateTime      @default(now())
  version          Int           @default(0)
  isActif          Boolean       @default(true)
  isDeleted        Boolean       @default(false)
  dateCreation     DateTime      @default(now())
  creePar          String?       @db.VarChar(50)
  dateModification DateTime      @updatedAt
  modifiePar       String?       @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?       @db.VarChar(50)

  canal         Canal                 @relation(fields: [codeCanal], references: [code], onUpdate: Cascade, onDelete: Restrict)
  depot         Depot                 @relation(fields: [codeDepot], references: [code], onUpdate: Cascade, onDelete: Restrict)
  saisiePar     Utilisateur           @relation(fields: [loginSaisie], references: [login], onUpdate: Cascade, onDelete: Restrict)
  lignes        LigneDemande[]
  historique    HistoriqueDemande[]
  modifications DemandeModification[]

  @@index([statut, dateSaisie])
  @@index([codeCanal, statut])
  @@index([codeDepot])
  @@index([loginSaisie])
  @@index([dateSaisie])
  @@map("demande")
}

model LigneDemande {
  numeroDemande          String         @db.VarChar(20)
  numeroLigne            Int
  codeArticle            String         @db.VarChar(30)
  unite                  Unite
  quantiteInitiale       Int
  quantite               Int
  dateLivraisonSouhaitee DateTime       @db.Date
  dateExpeditionPrevue   DateTime?      @db.Date
  decisionDepot          DecisionLigne?
  motifDecision          String?        @db.VarChar(500)
  isActif                Boolean        @default(true)
  isDeleted              Boolean        @default(false)
  dateCreation           DateTime       @default(now())
  creePar                String?        @db.VarChar(50)
  dateModification       DateTime       @updatedAt
  modifiePar             String?        @db.VarChar(50)
  dateSuppression        DateTime?
  supprimePar            String?        @db.VarChar(50)

  demande Demande @relation(fields: [numeroDemande], references: [numero], onUpdate: Cascade, onDelete: Restrict)
  article Article @relation(fields: [codeArticle], references: [codeArticle], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroDemande, numeroLigne])
  @@index([codeArticle])
  @@map("ligne_demande")
}

/// Historique fonctionnel visible sur chaque demande (ajout seul).
model HistoriqueDemande {
  numeroDemande   String   @db.VarChar(20)
  numeroEvenement Int
  horodatage      DateTime @default(now()) @db.DateTime(3)
  login           String   @db.VarChar(50)
  libelle         String   @db.Text

  demande Demande @relation(fields: [numeroDemande], references: [numero], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroDemande, numeroEvenement])
  @@map("historique_demande")
}

/// Demande de modification (RG-04) tranchée par le détenteur courant.
model DemandeModification {
  numeroDemande      String             @db.VarChar(20)
  numeroModification Int
  loginDemandeur     String             @db.VarChar(50)
  codeRoleDemandeur  String             @db.VarChar(30)
  statut             StatutModification @default(EN_ATTENTE)
  motif              String             @db.Text
  resume             String             @db.Text
  /// [{ numeroLigne, quantite, dateLivraisonSouhaitee, dateExpeditionPrevue }]
  contenu            Json
  loginDecision      String?            @db.VarChar(50)
  dateDecision       DateTime?
  motifDecision      String?            @db.Text
  isActif            Boolean            @default(true)
  isDeleted          Boolean            @default(false)
  dateCreation       DateTime           @default(now())
  creePar            String?            @db.VarChar(50)
  dateModification   DateTime           @updatedAt
  modifiePar         String?            @db.VarChar(50)
  dateSuppression    DateTime?
  supprimePar        String?            @db.VarChar(50)

  demande Demande @relation(fields: [numeroDemande], references: [numero], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroDemande, numeroModification])
  @@index([statut])
  @@map("demande_modification")
}

// ───────────────────────────── Comptes rendus journaliers des dépôts ─────────────────────────────

model Societe {
  code             String    @id @db.VarChar(30)
  libelle          String    @db.VarChar(100)
  ordre            Int       @default(0)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  magasins Magasin[]

  @@map("societe")
}

/// Magasin d'un dépôt, appartenant à une société (Promofood, Beesky…).
model Magasin {
  code             String    @id @db.VarChar(30)
  libelle          String    @db.VarChar(100)
  codeDepot        String    @db.VarChar(30)
  codeSociete      String    @db.VarChar(30)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  depot       Depot              @relation(fields: [codeDepot], references: [code], onUpdate: Cascade, onDelete: Restrict)
  societe     Societe            @relation(fields: [codeSociete], references: [code], onUpdate: Cascade, onDelete: Restrict)
  stocks      CompteRenduStock[]
  vehicules   Vehicule[]
  inventaires Inventaire[]

  @@index([codeDepot])
  @@index([codeSociete])
  @@map("magasin")
}

/// Véhicule de la flotte, rattaché à une agence (magasin), donc à un dépôt et à une société.
model Vehicule {
  matricule         String    @id @db.VarChar(30)
  codeMagasin       String    @db.VarChar(30)
  /// Dépôt du magasin, dénormalisé pour filtrer la liste d'un dépôt.
  codeDepot         String    @db.VarChar(30)
  chauffeurHabituel String?   @db.VarChar(100)
  description       String?   @db.VarChar(100)
  isActif           Boolean   @default(true)
  isDeleted         Boolean   @default(false)
  dateCreation      DateTime  @default(now())
  creePar           String?   @db.VarChar(50)
  dateModification  DateTime  @updatedAt
  modifiePar        String?   @db.VarChar(50)
  dateSuppression   DateTime?
  supprimePar       String?   @db.VarChar(50)

  magasin Magasin @relation(fields: [codeMagasin], references: [code], onUpdate: Cascade, onDelete: Restrict)
  depot   Depot   @relation(fields: [codeDepot], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([codeDepot])
  @@index([codeMagasin])
  @@map("vehicule")
}

/// En-tête de l'inventaire d'un magasin pour une journée : clôturé par l'agent,
/// il n'est plus modifiable sauf réouverture motivée par l'administrateur.
model Inventaire {
  codeMagasin      String           @db.VarChar(30)
  dateJournee      DateTime         @db.Date
  codeDepot        String           @db.VarChar(30)
  statut           StatutInventaire @default(EN_COURS)
  dateCloture      DateTime?
  loginCloture     String?          @db.VarChar(50)
  nbReouvertures   Int              @default(0)
  version          Int              @default(0)
  isActif          Boolean          @default(true)
  isDeleted        Boolean          @default(false)
  dateCreation     DateTime         @default(now())
  creePar          String?          @db.VarChar(50)
  dateModification DateTime         @updatedAt
  modifiePar       String?          @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?          @db.VarChar(50)

  magasin      Magasin                 @relation(fields: [codeMagasin], references: [code], onUpdate: Cascade, onDelete: Restrict)
  lignes       InventaireLigne[]
  reouvertures InventaireReouverture[]

  @@id([codeMagasin, dateJournee])
  @@index([codeDepot, dateJournee])
  @@index([statut])
  @@map("inventaire")
}

/// Historique des réouvertures d'inventaire par l'administrateur (ajout seul).
model InventaireReouverture {
  codeMagasin     String   @db.VarChar(30)
  dateJournee     DateTime @db.Date
  numero          Int
  motif           String   @db.Text
  loginAdmin      String   @db.VarChar(50)
  dateReouverture DateTime @default(now()) @db.DateTime(3)

  inventaire Inventaire @relation(fields: [codeMagasin, dateJournee], references: [codeMagasin, dateJournee], onUpdate: Cascade, onDelete: Restrict)

  @@id([codeMagasin, dateJournee, numero])
  @@map("inventaire_reouverture")
}

/// Inventaire journalier en quantités (pièces) : une ligne par magasin, journée et article.
/// Il alimente, valorisé au prix de revient, la « situation du stock » du compte rendu.
model InventaireLigne {
  codeMagasin         String    @db.VarChar(30)
  dateJournee         DateTime  @db.Date
  codeArticle         String    @db.VarChar(30)
  codeDepot           String    @db.VarChar(30)
  /// Société du magasin au moment de l'inventaire (historique figé).
  codeSociete         String    @db.VarChar(30)
  stockInitial        Decimal   @default(0) @db.Decimal(14, 3)
  receptions          Decimal   @default(0) @db.Decimal(14, 3)
  ventes              Decimal   @default(0) @db.Decimal(14, 3)
  retours             Decimal   @default(0) @db.Decimal(14, 3)
  stockFinalTheorique Decimal   @default(0) @db.Decimal(14, 3)
  /// Null tant que l'article n'a pas été compté.
  stockFinalReel      Decimal?  @db.Decimal(14, 3)
  ecart               Decimal   @default(0) @db.Decimal(14, 3)
  /// Prix de revient appliqué (figé au moment de la saisie).
  prixRevient         Decimal   @default(0) @db.Decimal(14, 3)
  loginAgent          String    @db.VarChar(50)
  isActif             Boolean   @default(true)
  isDeleted           Boolean   @default(false)
  dateCreation        DateTime  @default(now())
  creePar             String?   @db.VarChar(50)
  dateModification    DateTime  @updatedAt
  modifiePar          String?   @db.VarChar(50)
  dateSuppression     DateTime?
  supprimePar         String?   @db.VarChar(50)

  inventaire Inventaire @relation(fields: [codeMagasin, dateJournee], references: [codeMagasin, dateJournee], onUpdate: Cascade, onDelete: Restrict)
  article    Article    @relation(fields: [codeArticle], references: [codeArticle], onUpdate: Cascade, onDelete: Restrict)

  @@id([codeMagasin, dateJournee, codeArticle])
  @@index([codeDepot, dateJournee])
  @@index([codeArticle])
  @@map("inventaire_ligne")
}

/// Compte rendu journalier d'un dépôt (ENR-08) : un seul par dépôt et par jour.
/// Montants en dinars, 3 décimales (millimes).
model CompteRendu {
  numero               String            @id @db.VarChar(20)
  codeDepot            String            @db.VarChar(30)
  dateJournee          DateTime          @db.Date
  loginAgent           String            @db.VarChar(50)
  statut               StatutCompteRendu @default(BROUILLON)
  justificationEcarts  String?           @db.Text
  aucunVehicule        Boolean           @default(false)
  observationsRecettes String?           @db.Text
  observationsCaisse   String?           @db.Text
  soldeVeilleDepenses  Decimal           @default(0) @db.Decimal(14, 3)
  soldeFinalDepenses   Decimal           @default(0) @db.Decimal(14, 3)
  observationsDepenses String?           @db.Text
  etatCameras          String?           @db.Text
  ressourcesHumaines   String?           @db.Text
  remarques            String?           @db.Text
  dateSoumission       DateTime?
  version              Int               @default(0)
  isActif              Boolean           @default(true)
  isDeleted            Boolean           @default(false)
  dateCreation         DateTime          @default(now())
  creePar              String?           @db.VarChar(50)
  dateModification     DateTime          @updatedAt
  modifiePar           String?           @db.VarChar(50)
  dateSuppression      DateTime?
  supprimePar          String?           @db.VarChar(50)

  depot     Depot                 @relation(fields: [codeDepot], references: [code], onUpdate: Cascade, onDelete: Restrict)
  agent     Utilisateur           @relation(fields: [loginAgent], references: [login], onUpdate: Cascade, onDelete: Restrict)
  stocks    CompteRenduStock[]
  vehicules CompteRenduVehicule[]
  recettes  CompteRenduRecette[]
  caisses   CompteRenduCaisse[]
  depenses  CompteRenduDepense[]
  pieces    CompteRenduPiece[]

  @@unique([codeDepot, dateJournee])
  @@index([dateJournee])
  @@index([loginAgent])
  @@map("compte_rendu")
}

/// Situation du stock au coût de revient, une ligne par magasin du dépôt.
model CompteRenduStock {
  numeroCompteRendu   String    @db.VarChar(20)
  codeMagasin         String    @db.VarChar(30)
  /// Société du magasin au moment du compte rendu (historique figé).
  codeSociete         String    @db.VarChar(30)
  stockInitial        Decimal   @default(0) @db.Decimal(14, 3)
  receptions          Decimal   @default(0) @db.Decimal(14, 3)
  ventes              Decimal   @default(0) @db.Decimal(14, 3)
  retours             Decimal   @default(0) @db.Decimal(14, 3)
  stockFinalTheorique Decimal   @default(0) @db.Decimal(14, 3)
  stockFinalReel      Decimal   @default(0) @db.Decimal(14, 3)
  ecart               Decimal   @default(0) @db.Decimal(14, 3)
  isActif             Boolean   @default(true)
  isDeleted           Boolean   @default(false)
  dateCreation        DateTime  @default(now())
  creePar             String?   @db.VarChar(50)
  dateModification    DateTime  @updatedAt
  modifiePar          String?   @db.VarChar(50)
  dateSuppression     DateTime?
  supprimePar         String?   @db.VarChar(50)

  compteRendu CompteRendu @relation(fields: [numeroCompteRendu], references: [numero], onUpdate: Cascade, onDelete: Restrict)
  magasin     Magasin     @relation(fields: [codeMagasin], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroCompteRendu, codeMagasin])
  @@index([codeMagasin])
  @@map("compte_rendu_stock")
}

model CompteRenduVehicule {
  numeroCompteRendu String    @db.VarChar(20)
  numeroLigne       Int
  codeSociete       String    @db.VarChar(30)
  /// Agence (magasin) du véhicule au moment du compte rendu.
  codeMagasin       String?   @db.VarChar(30)
  vendeurChauffeur  String    @db.VarChar(100)
  matricule         String    @db.VarChar(30)
  heureEntree       String    @db.VarChar(5)
  heureSortie       String?   @db.VarChar(5)
  observations      String?   @db.VarChar(500)
  isActif           Boolean   @default(true)
  isDeleted         Boolean   @default(false)
  dateCreation      DateTime  @default(now())
  creePar           String?   @db.VarChar(50)
  dateModification  DateTime  @updatedAt
  modifiePar        String?   @db.VarChar(50)
  dateSuppression   DateTime?
  supprimePar       String?   @db.VarChar(50)

  compteRendu CompteRendu @relation(fields: [numeroCompteRendu], references: [numero], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroCompteRendu, numeroLigne])
  @@map("compte_rendu_vehicule")
}

/// Suivi de la caisse recettes : écart = recette − (CA au comptant + recouvrement).
model CompteRenduRecette {
  numeroCompteRendu String    @db.VarChar(20)
  numeroLigne       Int
  agent             String    @db.VarChar(100)
  codeSociete       String    @db.VarChar(30)
  caComptant        Decimal   @default(0) @db.Decimal(14, 3)
  recouvrement      Decimal   @default(0) @db.Decimal(14, 3)
  caCredit          Decimal   @default(0) @db.Decimal(14, 3)
  recette           Decimal   @default(0) @db.Decimal(14, 3)
  ecart             Decimal   @default(0) @db.Decimal(14, 3)
  isActif           Boolean   @default(true)
  isDeleted         Boolean   @default(false)
  dateCreation      DateTime  @default(now())
  creePar           String?   @db.VarChar(50)
  dateModification  DateTime  @updatedAt
  modifiePar        String?   @db.VarChar(50)
  dateSuppression   DateTime?
  supprimePar       String?   @db.VarChar(50)

  compteRendu CompteRendu @relation(fields: [numeroCompteRendu], references: [numero], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroCompteRendu, numeroLigne])
  @@map("compte_rendu_recette")
}

/// Récapitulatif caisse recettes par nature : D = A + B − C, écart = E − D.
model CompteRenduCaisse {
  numeroCompteRendu String       @db.VarChar(20)
  nature            NatureCaisse
  precision         String?      @db.VarChar(100)
  soldeVeille       Decimal      @default(0) @db.Decimal(14, 3)
  encaissements     Decimal      @default(0) @db.Decimal(14, 3)
  transferts        Decimal      @default(0) @db.Decimal(14, 3)
  soldeTheorique    Decimal      @default(0) @db.Decimal(14, 3)
  soldeReel         Decimal      @default(0) @db.Decimal(14, 3)
  ecart             Decimal      @default(0) @db.Decimal(14, 3)
  observations      String?      @db.VarChar(500)
  isActif           Boolean      @default(true)
  isDeleted         Boolean      @default(false)
  dateCreation      DateTime     @default(now())
  creePar           String?      @db.VarChar(50)
  dateModification  DateTime     @updatedAt
  modifiePar        String?      @db.VarChar(50)
  dateSuppression   DateTime?
  supprimePar       String?      @db.VarChar(50)

  compteRendu CompteRendu @relation(fields: [numeroCompteRendu], references: [numero], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroCompteRendu, nature])
  @@map("compte_rendu_caisse")
}

/// Suivi de la caisse dépenses : solde courant calculé à partir du solde veille.
model CompteRenduDepense {
  numeroCompteRendu String    @db.VarChar(20)
  numeroLigne       Int
  libelle           String    @db.VarChar(200)
  debit             Decimal   @default(0) @db.Decimal(14, 3)
  credit            Decimal   @default(0) @db.Decimal(14, 3)
  solde             Decimal   @default(0) @db.Decimal(14, 3)
  validePar         String    @db.VarChar(100)
  isActif           Boolean   @default(true)
  isDeleted         Boolean   @default(false)
  dateCreation      DateTime  @default(now())
  creePar           String?   @db.VarChar(50)
  dateModification  DateTime  @updatedAt
  modifiePar        String?   @db.VarChar(50)
  dateSuppression   DateTime?
  supprimePar       String?   @db.VarChar(50)

  compteRendu CompteRendu @relation(fields: [numeroCompteRendu], references: [numero], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroCompteRendu, numeroLigne])
  @@map("compte_rendu_depense")
}

/// Pièces annexées (états de stock système édités avant la clôture). Fichiers stockés sur disque.
model CompteRenduPiece {
  numeroCompteRendu String        @db.VarChar(20)
  numeroPiece       Int
  rubrique          RubriquePiece @default(STOCK)
  nomFichier        String        @db.VarChar(255)
  typeMime          String        @db.VarChar(100)
  taille            Int
  fichierStocke     String        @db.VarChar(255)
  sha256            String        @db.Char(64)
  isActif           Boolean       @default(true)
  isDeleted         Boolean       @default(false)
  dateCreation      DateTime      @default(now())
  creePar           String?       @db.VarChar(50)
  dateModification  DateTime      @updatedAt
  modifiePar        String?       @db.VarChar(50)
  dateSuppression   DateTime?
  supprimePar       String?       @db.VarChar(50)

  compteRendu CompteRendu @relation(fields: [numeroCompteRendu], references: [numero], onUpdate: Cascade, onDelete: Restrict)

  @@id([numeroCompteRendu, numeroPiece])
  @@map("compte_rendu_piece")
}

// ───────────────────────────── Technique ─────────────────────────────

/// Compteurs des numéros métier (DA-000001, IMP-000001…), incrémentés de façon atomique.
model Compteur {
  cle              String   @id @db.VarChar(30)
  valeur           Int      @default(0)
  dateModification DateTime @updatedAt

  @@map("compteur")
}

model ImportFichier {
  numero           String     @id @db.VarChar(20)
  type             TypeImport
  nomFichier       String     @db.VarChar(255)
  login            String     @db.VarChar(50)
  nbLignes         Int        @default(0)
  nbAjoutes        Int        @default(0)
  nbMisAJour       Int        @default(0)
  nbIgnores        Int        @default(0)
  nbQuotasAjustes  Int        @default(0)
  detail           Json?
  isActif          Boolean    @default(true)
  isDeleted        Boolean    @default(false)
  dateCreation     DateTime   @default(now())
  creePar          String?    @db.VarChar(50)
  dateModification DateTime   @updatedAt
  modifiePar       String?    @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?    @db.VarChar(50)

  @@map("import_fichier")
}

/// Paramètres modifiables sans redéploiement (verrouillage, politique de mot de passe…).
model Parametre {
  cle              String    @id @db.VarChar(60)
  valeur           String    @db.VarChar(255)
  description      String?   @db.VarChar(255)
  isActif          Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  dateCreation     DateTime  @default(now())
  creePar          String?   @db.VarChar(50)
  dateModification DateTime  @updatedAt
  modifiePar       String?   @db.VarChar(50)
  dateSuppression  DateTime?
  supprimePar      String?   @db.VarChar(50)

  @@map("parametre")
}

/// Journal d'audit inaltérable : qui, quand, quoi, valeurs avant/après (module 9).
/// La référence est un ULID (horodaté, triable) : il n'existe pas de clé métier naturelle pour un événement.
model JournalAudit {
  reference  String   @id @db.Char(26)
  horodatage DateTime @default(now()) @db.DateTime(3)
  login      String?  @db.VarChar(50)
  codeRole   String?  @db.VarChar(30)
  action     String   @db.VarChar(60)
  entite     String?  @db.VarChar(40)
  cleEntite  String?  @db.VarChar(80)
  avant      Json?
  apres      Json?
  detail     String?  @db.Text
  succes     Boolean  @default(true)
  adresseIp  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)

  @@index([horodatage])
  @@index([login, horodatage])
  @@index([entite, cleEntite])
  @@index([action])
  @@map("journal_audit")
}
