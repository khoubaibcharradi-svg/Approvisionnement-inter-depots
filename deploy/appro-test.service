# /etc/systemd/system/appro-test.service — environnement de recette (branche test), port 3001
[Unit]
Description=Portail approvisionnement inter-depots - RECETTE (Next.js)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=appro
WorkingDirectory=/opt/appro-test
Environment=NODE_ENV=production
Environment=TZ=Africa/Tunis
ExecStart=/usr/bin/npm start -- -H 127.0.0.1 -p 3001
Restart=always
RestartSec=5
# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/appro-test

[Install]
WantedBy=multi-user.target
