# Connexion MySQL 8 (utf8mb4). Un pool de 20 connexions couvre largement 60 utilisateurs.
DATABASE_URL="mysql://appro:motdepasse@localhost:3306/appro?connection_limit=20&pool_timeout=20"

# Secret de signature des sessions (au moins 32 caractères aléatoires : openssl rand -base64 48)
SESSION_SECRET="a-remplacer-par-une-valeur-aleatoire-longue"
# (Développement) adresses réseau autorisées à ouvrir « npm run dev », séparées par des virgules
# DEV_ORIGINS="192.168.1.243"

# Durée d'une session, en heures
SESSION_DUREE_HEURES=10
# Déconnexion automatique après inactivité (minutes)
SESSION_INACTIVITE_MINUTES=30

# Fichier de paramétrage utilisé par le seed (non versionné)
SEED_FICHIER="./prisma/data/parametrage.xlsx"

# Mot de passe initial des comptes créés par le seed (changement obligatoire à la 1re connexion)
SEED_MOT_DE_PASSE_INITIAL="Bienvenue2026!"

# Journalisation : dossier des fichiers .log (un fichier par jour) et durée de conservation
LOG_DIR="./logs"
LOG_NIVEAU="info"
LOG_RETENTION_JOURS=1825

# Sauvegardes texte de la base : dossier, heure quotidienne (HH:MM, heure du serveur) et rétention
BACKUP_DIR="./backups"
BACKUP_HEURE="02:00"
BACKUP_RETENTION_JOURS=90
# Dossier des pièces jointes des comptes rendus dépôts (à sauvegarder avec BACKUP_DIR)
PIECES_DIR="./pieces-jointes"

# Mettre à false si la sauvegarde est planifiée par le cron système (npm run db:backup)
BACKUP_AUTO=true
